# Partition layout: wic/rockchip_ab.wks. The mounts live here, not in wic's fstab update:
# wic only patches the rootfs copies inside the .wic, the rootfs in the .swu is this file
# as is, so an updated slot would come up without /boot and /var.

/dev/root            /                    auto       defaults              1  1
proc                 /proc                proc       defaults              0  0
devpts               /dev/pts             devpts     mode=0620,ptmxmode=0666,gid=5      0  0
tmpfs                /run                 tmpfs      mode=0755,nodev,nosuid,strictatime 0  0
tmpfs                /var/volatile        tmpfs      defaults              0  0

# Shared by both slots: kernels (fitImageA/B) and extlinux, and persistent data.
PARTLABEL=boot       /boot                vfat       defaults              0  0
PARTLABEL=data       /var                 ext4       defaults              0  0
