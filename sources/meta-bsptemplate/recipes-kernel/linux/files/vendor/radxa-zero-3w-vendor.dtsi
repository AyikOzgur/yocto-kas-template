
/*
 * Board adjustments on top of Radxa's rk3566-radxa-zero-3w-aic8800ds2.dts,
 * appended by linux-radxa_6.1.bb.
 */

/* Serial console on ttyS2 1500000 like the mainline image (Radxa leaves it off). */
&uart2 {
    status = "okay";
};

/*
 * Flight controller MAVLink on ttyS4 (UART4-M1, header pin 16 RX, pin 18 TX).
 * The SoC dtsi defaults to the M0 pins, which aren't on the header.
 */
&uart4 {
    pinctrl-names = "default";
    pinctrl-0 = <&uart4m1_xfer>;
    status = "okay";
};

/*
 * Wi-Fi on the external antenna connector (U.FL) instead of the onboard chip antenna.
 * The RF switch is held by board_antenna: the vendor dts drives GPIO3_D3 low (onboard),
 * Radxa's radxa-zero3-external-antenna overlay drives GPIO3_D2 low instead. Same here.
 * Off for now: the onboard Wi-Fi uses the chip antenna, both external antennas go to
 * the RTL8812EU (wfb-ng video). Uncomment to switch back.
 */
// &board_antenna {
//     gpio = <&gpio3 RK_PD2 GPIO_ACTIVE_LOW>;
// };
//
// &ant_1 {
//     rockchip,pins = <3 RK_PD2 RK_FUNC_GPIO &pcfg_pull_down>;
// };

/* NPU and its IOMMU are disabled in the vendor dtsi (Radxa enables them with an overlay). */
&rknpu {
    status = "okay";
};

&rknpu_mmu {
    status = "okay";
};

/*
 * Default CMA area, also exported as /dev/dma_heap/linux,cma (preprocessing output).
 * Below 4 GiB for 32-bit DMA masters (0xf0000000+ is MMIO).
 */
&reserved_memory {
    linux,cma {
        compatible = "shared-dma-pool";
        reusable;
        size = <0x0 0x8000000>; /* 128 MiB */
        alloc-ranges = <0x0 0x0 0x0 0xf0000000>;
        linux,cma-default;
    };
};

/*
 * USB 2.0 OTG Type-C port as host (USB camera). Radxa leaves it in "otg" with the role
 * taken from the PHY's ID/VBUS detection, which ends up as peripheral on this board.
 * The board is powered from the header, so the port isn't needed for power or gadget mode.
 */
&usbdrd_dwc3 {
    dr_mode = "host";
};

/*
 * Arducam IMX462 Pivariety module (2 MIPI lanes) on the 22-pin CSI connector. An MCU on
 * the module (I2C2-M1, address 0x0c) runs the sensor, configured like Raspberry Pi's
 * arducam-pivariety overlay. Power switched by GPIO3_C6, CSI D-PHY straight into the ISP.
 * The ISP output is the video node named rkisp_mainpath (/dev/video-camera0).
 */
/ {
    /* The driver wants a 24 MHz xclk, the module has its own oscillator. */
    clk_cam_24m: external-camera-clock-24m {
        compatible = "fixed-clock";
        clock-frequency = <24000000>;
        clock-output-names = "clk_cam_24m";
        #clock-cells = <0>;
    };

    camera_pwdn_gpio: camera-pwdn-gpio {
        compatible = "regulator-fixed";
        regulator-name = "camera_pwdn_gpio";
        regulator-always-on;
        regulator-boot-on;
        enable-active-high;
        gpio = <&gpio3 RK_PC6 GPIO_ACTIVE_HIGH>;
    };
};

&i2c2 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&i2c2m1_xfer>;
    #address-cells = <1>;
    #size-cells = <0>;

    camera_pivariety: camera-pivariety@c {
        compatible = "arducam,arducam-pivariety";
        reg = <0x0c>;
        clocks = <&clk_cam_24m>;
        clock-names = "xclk";

        port {
            pivariety_out0: endpoint {
                remote-endpoint = <&mipi_in_pivariety>;
                data-lanes = <1 2>;
                clock-noncontinuous;
                /* Same as the Raspberry Pi overlay; sets the D-PHY timing and ISP clock. */
                link-frequencies = /bits/ 64 <493500000>;
            };
        };
    };
};

&csi2_dphy_hw {
    status = "okay";
};

&csi2_dphy0 {
    status = "okay";

    ports {
        #address-cells = <1>;
        #size-cells = <0>;

        port@0 {
            reg = <0>;
            #address-cells = <1>;
            #size-cells = <0>;

            mipi_in_pivariety: endpoint@1 {
                reg = <1>;
                remote-endpoint = <&pivariety_out0>;
                data-lanes = <1 2>;
            };
        };

        port@1 {
            reg = <1>;
            #address-cells = <1>;
            #size-cells = <0>;

            dphy0_out: endpoint@1 {
                reg = <1>;
                remote-endpoint = <&isp0_in>;
            };
        };
    };
};

&rkisp_vir0 {
    status = "okay";

    port {
        #address-cells = <1>;
        #size-cells = <0>;

        isp0_in: endpoint@0 {
            reg = <0>;
            remote-endpoint = <&dphy0_out>;
        };
    };
};

&rkisp {
    status = "okay";
};

&rkisp_mmu {
    status = "okay";
};

&rkcif {
    status = "okay";
};

&rkcif_mmu {
    status = "okay";
};
