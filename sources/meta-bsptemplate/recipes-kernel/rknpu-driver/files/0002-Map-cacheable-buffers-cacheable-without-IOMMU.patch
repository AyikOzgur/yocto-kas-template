From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ozgurayik <aozgurayik@hotmail.com>
Date: Tue, 6 Oct 2026 15:50:24 +0200
Subject: [PATCH] Map cacheable buffers cacheable without IOMMU

Mainline removed DMA_ATTR_NON_CONSISTENT, so on this non-coherent device
dma_alloc_attrs() + dma_mmap_attrs() always map buffers uncached for
userspace, even when the runtime asks for RKNPU_MEM_CACHEABLE. Reading
NPU outputs from the CPU then runs at ~80 MB/s (YOLOv8n: ~15 ms per
frame just to read 1.2 MB of outputs).

Without IOMMU, allocate cacheable contiguous buffers with
dma_alloc_pages() and map them with remap_pfn_range() using the
cacheable page protection set in rknpu_gem_mmap_obj(). The existing
RKNPU_MEM_SYNC path for contiguous buffers already does the needed
dma_sync_single_range_for_{cpu,device}() (rknn_mem_sync).

Upstream-Status: Pending
---
 src/rknpu_gem.c | 103 +++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 101 insertions(+), 2 deletions(-)

diff --git a/src/rknpu_gem.c b/src/rknpu_gem.c
index b8dcdc8..4f5914d 100644
--- a/src/rknpu_gem.c
+++ b/src/rknpu_gem.c
@@ -140,6 +140,87 @@ static void rknpu_gem_put_pages(struct rknpu_gem_object *rknpu_obj)
 }
 #endif
 
+/*
+ * Mainline has no DMA_ATTR_NON_CONSISTENT, so on this non-coherent device
+ * dma_alloc_attrs() + dma_mmap_attrs() always give userspace an uncached
+ * mapping, even for RKNPU_MEM_CACHEABLE. CPU reads of NPU outputs then cost
+ * one DRAM access each. Without IOMMU, allocate cacheable contiguous buffers
+ * with dma_alloc_pages() instead: they are mapped cacheable and
+ * RKNPU_MEM_SYNC already does the cache maintenance for contiguous buffers
+ * with dma_sync_single_range_for_{cpu,device}().
+ */
+static bool rknpu_gem_use_cached_pages(struct rknpu_gem_object *rknpu_obj)
+{
+	struct rknpu_device *rknpu_dev = rknpu_obj->base.dev->dev_private;
+
+	return (rknpu_obj->flags & RKNPU_MEM_CACHEABLE) &&
+	       !(rknpu_obj->flags & RKNPU_MEM_NON_CONTIGUOUS) &&
+	       !rknpu_dev->iommu_en;
+}
+
+static int rknpu_gem_alloc_cached_pages(struct rknpu_gem_object *rknpu_obj,
+					gfp_t gfp_mask, unsigned int nr_pages)
+{
+	struct drm_device *drm = rknpu_obj->base.dev;
+	struct sg_table *sgt = NULL;
+	struct page *page = NULL;
+	unsigned int i;
+	int ret;
+
+	/* dma_alloc_pages() picks the zone from the DMA mask and rejects zone flags. */
+	gfp_mask &= ~(__GFP_DMA | __GFP_DMA32 | __GFP_HIGHMEM);
+
+	page = dma_alloc_pages(drm->dev, rknpu_obj->size, &rknpu_obj->dma_addr,
+			       DMA_BIDIRECTIONAL, gfp_mask);
+	if (!page) {
+		LOG_DEV_ERROR(drm->dev, "failed to allocate cached %lu buffer.\n",
+			      rknpu_obj->size);
+		rknpu_obj->dma_addr = 0;
+		return -ENOMEM;
+	}
+
+	/*
+	 * dma_alloc_pages() zeroes the buffer through the cached linear map.
+	 * Clean it now, so no dirty line is later written back over data the
+	 * NPU produced.
+	 */
+	dma_sync_single_for_device(drm->dev, rknpu_obj->dma_addr,
+				   rknpu_obj->size, DMA_BIDIRECTIONAL);
+
+	rknpu_obj->cookie = page_address(page);
+	if (rknpu_obj->flags & RKNPU_MEM_KERNEL_MAPPING)
+		rknpu_obj->kv_addr = rknpu_obj->cookie;
+
+	sgt = kzalloc(sizeof(*sgt), GFP_KERNEL);
+	if (!sgt) {
+		ret = -ENOMEM;
+		goto err_free_pages;
+	}
+
+	ret = sg_alloc_table(sgt, 1, GFP_KERNEL);
+	if (ret)
+		goto err_free_sgt;
+	sg_set_page(sgt->sgl, page, rknpu_obj->size, 0);
+
+	for (i = 0; i < nr_pages; i++)
+		rknpu_obj->pages[i] = nth_page(page, i);
+
+	rknpu_obj->sgt = sgt;
+
+	return 0;
+
+err_free_sgt:
+	kfree(sgt);
+err_free_pages:
+	dma_free_pages(drm->dev, rknpu_obj->size, page, rknpu_obj->dma_addr,
+		       DMA_BIDIRECTIONAL);
+	rknpu_obj->cookie = NULL;
+	rknpu_obj->kv_addr = NULL;
+	rknpu_obj->dma_addr = 0;
+
+	return ret;
+}
+
 static int rknpu_gem_alloc_buf(struct rknpu_gem_object *rknpu_obj)
 {
 	struct drm_device *drm = rknpu_obj->base.dev;
@@ -210,6 +291,13 @@ static int rknpu_gem_alloc_buf(struct rknpu_gem_object *rknpu_obj)
 		return -ENOMEM;
 	}
 
+	if (rknpu_gem_use_cached_pages(rknpu_obj)) {
+		ret = rknpu_gem_alloc_cached_pages(rknpu_obj, gfp_mask, nr_pages);
+		if (ret < 0)
+			goto err_free;
+		return 0;
+	}
+
 	rknpu_obj->cookie = dma_alloc_attrs(drm->dev, rknpu_obj->size,
 					    &rknpu_obj->dma_addr, gfp_mask,
 					    rknpu_obj->dma_attrs);
@@ -320,8 +408,13 @@ static void rknpu_gem_free_buf(struct rknpu_gem_object *rknpu_obj)
 	sg_free_table(rknpu_obj->sgt);
 	kfree(rknpu_obj->sgt);
 
-	dma_free_attrs(drm->dev, rknpu_obj->size, rknpu_obj->cookie,
-		       rknpu_obj->dma_addr, rknpu_obj->dma_attrs);
+	if (rknpu_gem_use_cached_pages(rknpu_obj))
+		dma_free_pages(drm->dev, rknpu_obj->size,
+			       virt_to_page(rknpu_obj->cookie),
+			       rknpu_obj->dma_addr, DMA_BIDIRECTIONAL);
+	else
+		dma_free_attrs(drm->dev, rknpu_obj->size, rknpu_obj->cookie,
+			       rknpu_obj->dma_addr, rknpu_obj->dma_attrs);
 
 	rknpu_gem_free_page(rknpu_obj->pages);
 
@@ -1210,6 +1303,12 @@ static int rknpu_gem_mmap_buffer(struct rknpu_gem_object *rknpu_obj,
 	}
 #endif
 
+	/* Keeps the cacheable vm_page_prot set by rknpu_gem_mmap_obj(). */
+	if (rknpu_gem_use_cached_pages(rknpu_obj))
+		return remap_pfn_range(vma, vma->vm_start,
+				       page_to_pfn(rknpu_obj->pages[0]), vm_size,
+				       vma->vm_page_prot);
+
 	ret = dma_mmap_attrs(drm->dev, vma, rknpu_obj->cookie,
 			     rknpu_obj->dma_addr, rknpu_obj->size,
 			     rknpu_obj->dma_attrs);
-- 
