[Unit]
Description=Camera capture service

[Service]
# The camera: a preset from /etc/camera/ (device, requested size and fps, rotation), the
# default one is chosen at build time (CAMERA). Pixel format, actual size and frame rate go to
# the consumers in every frame header. Another camera without rebuilding (persistent data
# partition), then restart camera-service:
#   ln -sf /etc/camera/usb-grabber.env /var/camera.env
# Single settings work too, e.g. echo CAMERA_ROTATION=0 > /var/camera.env
EnvironmentFile=/etc/camera/default.env
EnvironmentFile=-/var/camera.env
ExecStartPre=-@@BINDIR@@/camera-setup.sh ${CAMERA_ROTATION}
ExecStart=@@BINDIR@@/camera-service --video ${CAMERA_VIDEO} --dma-heap /dev/dma_heap/system --width ${CAMERA_WIDTH} --height ${CAMERA_HEIGHT} --fps ${CAMERA_FPS}
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
