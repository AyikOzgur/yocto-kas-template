# Sony IMX219 (e.g. Arducam B0179) on the CSI connector, through the Rockchip ISP (vendor kernel).
CAMERA_VIDEO=/dev/video-camera0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=60
# Sensor mode (camera-setup.sh), the ISP scales it to CAMERA_WIDTH x CAMERA_HEIGHT:
#   1280x720   60 fps, 2x2 binned from a 2560x1440 center crop (78% of the sensor width)
#   1920x1080  30 fps, full resolution, center crop (58% of the width)
#   1640x1232  30 fps, 2x2 binned, the full sensor (4:3)
#   3280x2464  21 fps, full resolution, the full sensor (4:3)
CAMERA_SENSOR_SIZE=1280x720
# Degrees, 0 or 180 (sensor flip). The sensor sits upside down on IMX219 modules (Raspberry
# Pi's overlay says rotation 180 too): 180 gives an upright image with the module upright.
CAMERA_ROTATION=180
# isp-tuning-service options (white balance, exposure), e.g. --ae-target 0.2 --max-gain 1024
# (gain in the sensor's units, 256 = 1x for the IMX219)
ISP_TUNING_ARGS=
