# Arducam IMX462 (Pivariety) on the CSI connector, through the Rockchip ISP (vendor kernel).
# The sensor runs 1920x1080 at 60 fps, the ISP scales to the requested size.
CAMERA_VIDEO=/dev/video-camera0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=60
# Degrees, 0 or 180 (sensor flip). Mounted upside down in the frame.
CAMERA_ROTATION=180
# isp-tuning-service options (white balance, exposure), e.g. --ae-target 0.2 --max-gain 1600
ISP_TUNING_ARGS=
