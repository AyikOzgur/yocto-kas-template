[Unit]
Description=NPU inference test service (YOLO)
After=preprocessing-service.service
Wants=preprocessing-service.service

[Service]
# Keep NPU at highest frequency. The rknpu port's ondemand governor never
# ramps up (stays at the 594 MHz boot rate), devfreq clamps to min_freq.
ExecStartPre=/bin/sh -c 'cat /sys/class/devfreq/fde40000.npu/max_freq > /sys/class/devfreq/fde40000.npu/min_freq'
ExecStart=@@BINDIR@@/inference-service @@DATADIR@@/inference-service/yolov8n.rknn
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
