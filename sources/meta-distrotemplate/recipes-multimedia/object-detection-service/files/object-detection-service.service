[Unit]
Description=NPU inference test service (YOLO)
After=preprocessing-service.service
Wants=preprocessing-service.service

[Service]
Environment=INFERENCE_MODEL=@@DATADIR@@/object-detection-service/yolov8n.rknn
Environment=INFERENCE_CONF=@@INFERENCE_CONF@@
# Override without rebuilding (persistent data partition), e.g.:
#   echo INFERENCE_CONF=0.5 > /var/object-detection-service.env
#   echo INFERENCE_MODEL=@@DATADIR@@/object-detection-service/yolov5s.rknn >> /var/object-detection-service.env
EnvironmentFile=-/var/object-detection-service.env
# Keep NPU at highest frequency. The rknpu port's ondemand governor never
# ramps up (stays at the 594 MHz boot rate), devfreq clamps to min_freq.
ExecStartPre=/bin/sh -c 'cat /sys/class/devfreq/fde40000.npu/max_freq > /sys/class/devfreq/fde40000.npu/min_freq'
ExecStart=@@BINDIR@@/object-detection-service ${INFERENCE_MODEL} --conf ${INFERENCE_CONF}
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
