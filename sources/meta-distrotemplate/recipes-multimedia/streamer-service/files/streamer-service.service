[Unit]
Description=RTP/JPEG streamer (test)
After=renderer-service.service
Wants=renderer-service.service

[Service]
Environment=STREAMER_DEST=@@STREAMER_DEST@@
Environment=STREAMER_QUALITY=@@STREAMER_QUALITY@@
Environment=STREAMER_EXTRA_ARGS=
# Override without rebuilding (persistent data partition), e.g. stream:
#   echo STREAMER_DEST=192.168.1.42:5004 > /var/streamer-service.env
# or record 60 s to a file without network:
#   STREAMER_DEST=
#   STREAMER_EXTRA_ARGS=--record /var/recordings --record-seconds 60
EnvironmentFile=-/var/streamer-service.env
ExecStart=@@BINDIR@@/streamer-service --dest ${STREAMER_DEST} --quality ${STREAMER_QUALITY} $STREAMER_EXTRA_ARGS
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
